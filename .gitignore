# Secrets — NEVER commit the real config. Use the committed templates
# (odoo.conf.example / .prod / .dev) which carry only CHANGE_ME placeholders.
.env
odoo.conf

# Developer-only compose override (machine-specific build)
docker-compose.override.yml

# Data (lives on the server, not in Git)
postgres-data/
odoo-data/
backups/*.gz
backups/*.log
backups/*.dump
backups/*.sql.gz
custom-addons/
# Dedicated addon repos cloned beside this file on the server (own git repos):
erpmedsupply-addons/
odoo-nile-theme/

# NGINX HTTP-only backup (created by ssl-setup.sh)
nginx/active.conf
nginx/default.http-only.conf

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Manual build intermediates & previews (regenerated by scripts/build_manual.py)
docs/manual/_manual_*.html
docs/manual/_preview_*.png

# Python
__pycache__/
*.pyc
backups/*.tgz
